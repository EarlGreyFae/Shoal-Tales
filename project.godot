; Engine configuration file.
; Built for Godot 4.7. The Standard and .NET editors both work (the game is GDScript only).

config_version=5

[application]

config/name="Shoal Tales"
config/description="A cozy dredging, sorting and crafting game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/data.gd"
Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
